config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="yume nikki game jam"
config/description="Dean, Nick, and Chiel very cool game"
config/version="0.0.23"
run/main_scene="res://scenes/opening/opening.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

ss2d/version="3.3.1"

[application]

config/name="Dream Diary gamejam"
config/description="Dean, and Chiel, and Duke
very cool games"
config/version="0.0.36"
run/main_scene="uid://dxiafdb8vqcc5"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/use_filter=false
boot_splash/image="uid://de0lbndqydfuc"
config/icon="uid://55h2f6poebdk"

[audio]

buses/default_bus_layout="uid://ojvel7qrleuj"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
BetterTerrain="*uid://bfa68ymktrna3"
DialogueManager="*uid://c3rodes2l3gxb"
AppConfig="*uid://cjke6crjg14a0"
SceneLoader="*uid://cbwmrnp0af35y"
ProjectMusicController="*uid://r5t485lr3p7t"
ProjectUISoundController="*uid://cc37235kj4384"
DebugMenu="*uid://cggqb75a8w8r"

[debug]

file_logging/enable_file_logging=true
gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/return_value_discarded=1
gdscript/warnings/missing_await=1
shader_language/warnings/treat_warnings_as_errors=true

[display]

window/size/viewport_width=800
window/size/viewport_height=600

[editor_plugins]

enabled=PackedStringArray("res://addons/Todo_Manager/plugin.cfg", "res://addons/YouCanDoIt/plugin.cfg", "res://addons/better-terrain/plugin.cfg", "res://addons/debug_menu/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/fancy_folder_icons/plugin.cfg", "res://addons/godotresourcecleaner/plugin.cfg", "res://addons/maaacks_game_template/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/script-ide/plugin.cfg", "res://addons/virtual_joystick/plugin.cfg", "res://addons/your_buil/plugin.cfg")

[gui]

theme/custom="uid://dudh2k1jjvgdk"
theme/custom_font="uid://bdude2uqwyrt"

[importer_defaults]

cubemap_texture={
&"compress/mode": 4
}
cubemap_array_texture={
&"compress/mode": 4
}
2d_array_texture={
&"compress/channel_pack": 1,
&"compress/lossy_quality": 0.6,
&"mipmaps/generate": false
}
3d_texture={
&"compress/lossy_quality": 0.6
}
mp3={
&"loop": true
}
texture={
&"compress/channel_pack": 1,
&"compress/lossy_quality": 0.6,
&"compress/mode": 1,
&"compress/normal_map": 2,
&"detect_3d/compress_to": 0,
&"process/fix_alpha_border": false,
&"roughness/mode": 1
}

